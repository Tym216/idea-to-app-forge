# Demo: copy into .env.atoms-demo and use --mode atoms-demo; never fill missing values from Main .env.
VITE_FORGE_ENVIRONMENT_ID=atoms-demo
VITE_EXPECTED_SUPABASE_PROJECT_REF=
# Build/dev/runtime reject missing identity, Main/restore target, placeholder and key/ref mismatch.
# 仅公开配置。不要在 VITE_* 中填写 service role 或模型/沙箱密钥。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
