# ===== 服务端秘密配置:只放在 Worker 运行环境,禁止进入前端构建 =====

# Supabase(service_role 密钥拥有绕过 RLS 的权限)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 大模型:provider 可选 deepseek 或 zhipu
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-plus

# Daytona 执行环境
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_AUTO_STOP_MINUTES=120

# 循环预算:总工具步数与错误修复轮数分别配置
MAX_TOOL_STEPS=40
MAX_FIX_ROUNDS=1

# 任务租约与超时(毫秒)
LEASE_SECONDS=120
HEARTBEAT_MS=30000
POLL_INTERVAL_MS=3000
TASK_TIMEOUT_MS=900000
COMMAND_TIMEOUT_MS=300000

WORKER_ID=worker-1

# Langfuse Cloud 观测(可选,仅 Worker;只上传元数据与脱敏错误)
# 区域:日本 https://jp.cloud.langfuse.com  欧盟 https://cloud.langfuse.com  美国 https://us.cloud.langfuse.com
LANGFUSE_ENABLED=false
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# 审计记录保留天数(默认 90;Worker 每小时调用 ita_purge_audit_log 清理)
AUDIT_RETENTION_DAYS=90
