# ===== 服务端秘密配置:只放在 Worker 运行环境,禁止进入前端构建 =====

# Supabase(service_role 密钥拥有绕过 RLS 的权限)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 大模型:provider 可选 deepseek / zhipu / openrouter / gemini / ollama / lmstudio
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-plus

# 新入口必须显式选模型;只填当前 provider 所需的 Key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 可选:OpenRouter 上游供应商 slug,用于固定对比;不填则由 OpenRouter 首次选择
OPENROUTER_UPSTREAM=
OPENROUTER_JSON_MODE=off
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_JSON_MODE=off
# 本地 OpenAI 兼容接口：填写已下载/加载的模型 ID，Key 默认可空
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
OLLAMA_API_KEY=
OLLAMA_JSON_MODE=off
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=
LMSTUDIO_API_KEY=
LMSTUDIO_JSON_MODE=off
# JSON_MODE:off 用提示词+解析校验;on 仅用于确认支持 json_object 的模型
# auto 保留原有智谱/DeepSeek 兼容规则,新入口默认不强制 JSON

# Daytona 执行环境
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_AUTO_STOP_MINUTES=120

# 循环预算:总工具步数与错误修复轮数分别配置
MAX_TOOL_STEPS=40
MAX_FIX_ROUNDS=1

# 首批 Action Fusion：默认关闭，保留基线；开启后逐项执行并检查暂停/租约/预算
ACTION_FUSION_ENABLED=false
FUSION_MAX_FILES=8
FUSION_MAX_BYTES=131072
METRICS_CODE_VERSION=retry-v1

# 任务租约与超时(毫秒)
LEASE_SECONDS=120
HEARTBEAT_MS=30000
POLL_INTERVAL_MS=3000
TASK_TIMEOUT_MS=900000
COMMAND_TIMEOUT_MS=300000

WORKER_ID=worker-1

# Langfuse Cloud 观测(可选,仅 Worker;只上传元数据与脱敏错误)
# 区域:日本 https://jp.cloud.langfuse.com  欧盟 https://cloud.langfuse.com  美国 https://us.cloud.langfuse.com
LANGFUSE_ENABLED=false
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# 审计记录保留天数(默认 90;Worker 每小时调用 ita_purge_audit_log 清理)
AUDIT_RETENTION_DAYS=90
