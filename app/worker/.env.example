# Explicit target identity; Demo must use a dedicated complete file via FORGE_ENV_FILE.
FORGE_ENVIRONMENT_ID=atoms-demo
EXPECTED_SUPABASE_PROJECT_REF=
# Start later (not during local implementation): FORGE_ENV_FILE=/absolute/path/.env.demo npm start
# Future Main requires FORGE_ENVIRONMENT_ID=production-main plus its explicit expected ref.

# ===== 服务端秘密配置:只放在 Worker 运行环境,禁止进入前端构建 =====

# Supabase(service_role 密钥拥有绕过 RLS 的权限)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM:只配置正在使用的供应商；旧的 *_MODEL / *_BASE_URL / *_JSON_MODE 仍兼容
LLM_PROVIDER=deepseek
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_MS=120000
# 本地诊断：保存实际请求 body 和原始响应；可能含源码/用户需求，默认关闭
LLM_DEBUG_CAPTURE_REQUEST=false
PLAN_TEMPERATURE=
BUILD_TEMPERATURE=
LLM_JSON_MODE=auto
# 可选的供应商原生参数，必须是 JSON 对象；留空时沿用旧版推理配置
# 例如已确认的 DeepSeek 模型: PLAN_PROVIDER_OPTIONS={"thinking":{"type":"enabled"},"reasoning_effort":"high"}
PLAN_PROVIDER_OPTIONS=
BUILD_PROVIDER_OPTIONS=

# 旧版每供应商 Key / 模型 / URL 配置继续可用；通用 LLM_* 非空时优先
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-plus
ALIYUN_API_KEY=
ALIYUN_MODEL=
ALIYUN_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_UPSTREAM=
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_API_KEY=
OLLAMA_MODEL=
LMSTUDIO_API_KEY=
LMSTUDIO_MODEL=

# Daytona 执行环境
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_AUTO_STOP_MINUTES=120

# 循环预算:总工具步数与错误修复轮数分别配置
MAX_TOOL_STEPS=40
MAX_FIX_ROUNDS=1

# 首批 Action Fusion：默认关闭，保留基线；开启后逐项执行并检查暂停/租约/预算
ACTION_FUSION_ENABLED=false
FUSION_MAX_FILES=8
FUSION_MAX_BYTES=131072
METRICS_CODE_VERSION=retry-v1

# 任务租约与超时(毫秒)
LEASE_SECONDS=120
HEARTBEAT_MS=30000
POLL_INTERVAL_MS=3000
TASK_TIMEOUT_MS=900000
COMMAND_TIMEOUT_MS=300000

WORKER_ID=worker-1

# Langfuse Cloud 观测(可选,仅 Worker;只上传元数据与脱敏错误)
# 区域:日本 https://jp.cloud.langfuse.com  欧盟 https://cloud.langfuse.com  美国 https://us.cloud.langfuse.com
LANGFUSE_ENABLED=false
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# 审计记录保留天数(默认 90;Worker 每小时调用 ita_purge_audit_log 清理)
AUDIT_RETENTION_DAYS=90

# 可信硬输出上限（OpenRouter / 已确认 Aliyun 模型；空值保持旧行为）
# 每个明确 purpose 的覆盖优先于默认值；required 模式应保持全局值为空。
LLM_MAX_OUTPUT_TOKENS=
LLM_MAX_OUTPUT_TOKENS_PLAN=
LLM_MAX_OUTPUT_TOKENS_MEMORY=
LLM_REQUIRE_OUTPUT_CAP=false
# Trusted omission after provider options; empty/false preserves existing sampling behavior.
LLM_OMIT_TEMPERATURE=
# Trusted purpose-specific policy; Aliyun confirmed models support none -> enable_thinking=false.
LLM_REASONING_EFFORT_PLAN=
LLM_REASONING_EFFORT_MEMORY=
# true blocks inference purposes without an explicit policy before HTTP.
LLM_REQUIRE_REASONING_POLICY=false

# Trusted per-purpose Build policy (build_decision ONLY).
LLM_MAX_OUTPUT_TOKENS_BUILD=
LLM_REASONING_EFFORT_BUILD=
# Public Demo: explicit purposes only; no global/default reasoning policy.
LLM_MAX_OUTPUT_TOKENS_DESIGN=
LLM_REASONING_EFFORT_DESIGN=
LLM_MAX_OUTPUT_TOKENS_ACTION_PLAN=
LLM_REASONING_EFFORT_ACTION_PLAN=
# Optional execution-scoped theoretical exposure admission; trusted reviewed pricing, no live lookup.
# Every physical POST (including retries) reserves full cost; Build/Memory share one ledger.
LLM_REQUIRE_COST_BUDGET=false
LLM_COST_INPUT_USD_PER_MILLION=
LLM_COST_OUTPUT_USD_PER_MILLION=
LLM_MAX_THEORETICAL_COST_USD_PER_EXECUTION=

# Generic currency pricing; set all four together, leave legacy *_USD_* fields empty.
# Example Aliyun Beijing qwen3.8-flash: CNY / 0.8 / 2.7; verify prices before switching models.
LLM_COST_CURRENCY=
LLM_COST_INPUT_PER_MILLION=
LLM_COST_OUTPUT_PER_MILLION=
LLM_MAX_THEORETICAL_COST_PER_EXECUTION=
